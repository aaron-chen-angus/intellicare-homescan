{
  "universal_rules": [
    "hs.rule.lights", "hs.rule.people", "hs.rule.dont_tidy", "hs.rule.height",
    "hs.rule.landscape", "hs.rule.hold_still", "hs.rule.no_flash", "hs.rule.all_shots"
  ],
  "notes": "Every home is different, so the protocol is layout-agnostic: three photos per room, preferably from three different corners, each showing as much floor as possible. include = room-specific things worth getting into at least one photo. ghost stays empty (only the general floor-third guide line is shown on the camera).",
  "rooms": {
    "bedroom": {
      "required": [
        { "id": "bedroom_1", "label": "hs.shot.corner1", "include": "hs.inc.bedroom", "ghost": [] },
        { "id": "bedroom_2", "label": "hs.shot.corner2", "include": "hs.inc.bedroom", "ghost": [] },
        { "id": "bedroom_3", "label": "hs.shot.corner3", "include": "hs.inc.bedroom", "ghost": [] }
      ],
      "optional": ["hs.opt.bed_height", "hs.opt.bed_lamp", "hs.opt.wardrobe_top", "hs.opt.cords"]
    },
    "kitchen": {
      "required": [
        { "id": "kitchen_1", "label": "hs.shot.corner1", "include": "hs.inc.kitchen", "ghost": [] },
        { "id": "kitchen_2", "label": "hs.shot.corner2", "include": "hs.inc.kitchen", "ghost": [] },
        { "id": "kitchen_3", "label": "hs.shot.corner3", "include": "hs.inc.kitchen", "ghost": [] }
      ],
      "optional": ["hs.opt.gas", "hs.opt.counter_power", "hs.opt.sink_mat", "hs.opt.chemicals"]
    },
    "dining": {
      "required": [
        { "id": "dining_1", "label": "hs.shot.corner1", "include": "hs.inc.dining", "ghost": [] },
        { "id": "dining_2", "label": "hs.shot.corner2", "include": "hs.inc.dining", "ghost": [] },
        { "id": "dining_3", "label": "hs.shot.corner3", "include": "hs.inc.dining", "ghost": [] }
      ],
      "optional": ["hs.opt.chair_side", "hs.opt.glass_edges", "hs.opt.transition"]
    },
    "living": {
      "required": [
        { "id": "living_1", "label": "hs.shot.corner1", "include": "hs.inc.living", "ghost": [] },
        { "id": "living_2", "label": "hs.shot.corner2", "include": "hs.inc.living", "ghost": [] },
        { "id": "living_3", "label": "hs.shot.corner3", "include": "hs.inc.living", "ghost": [] }
      ],
      "optional": ["hs.opt.tv_power", "hs.opt.tall_shelves", "hs.opt.zone_floor", "hs.opt.thresholds"]
    }
  }
